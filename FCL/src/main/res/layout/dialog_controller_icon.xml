<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:text="@string/edit_button_icon_choose"
        android:textSize="18sp" app:auto_text_tint="true" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/icons" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="10dp" android:clipToPadding="false"
        android:padding="4dp" />
    <com.tungsten.fcllibrary.component.view.FCLButton
        android:id="@+id/cancel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/dialog_negative" />
</LinearLayout>
