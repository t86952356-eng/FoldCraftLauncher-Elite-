<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="96dp"
    android:layout_margin="4dp" android:gravity="center" android:orientation="vertical"
    android:padding="8dp" android:clickable="true" android:focusable="true">
    <com.tungsten.fcllibrary.component.view.FCLImageView
        android:id="@+id/icon" android:layout_width="48dp" android:layout_height="48dp"
        android:background="@drawable/bg_controller_icon_preview" android:padding="10dp"
        android:scaleType="fitCenter" />
    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center"
        android:maxLines="1" android:textSize="11sp" app:auto_text_tint="true" />
</LinearLayout>
